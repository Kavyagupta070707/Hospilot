{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/sessions",
      "dest": "/api/sessions.js"
    },
    {
      "src": "/api/sessions/([^/]+)",
      "dest": "/api/sessions/[sessionId].js?sessionId=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
